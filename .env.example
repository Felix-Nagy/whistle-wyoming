HA_URL=http://127.0.0.1:8123
HA_TOKEN=your_long_lived_access_token
WHISTLE_LANGUAGE=en
WHISTLE_MAX_KEYWORDS=200
WHISTLE_REFRESH=3600
# Optional, comma-separated: words or phrases always favoured, e.g. groceries said by voice
WHISTLE_EXTRA_KEYWORDS=
# Ignore audio past this many seconds per request (0 = no limit)
WHISTLE_MAX_SECONDS=30
